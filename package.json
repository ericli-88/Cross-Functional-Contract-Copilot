{
  "name": "cross-functional-contract-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "check:encoding": "node scripts/check-encoding.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm check:encoding && pnpm build && node tests/bot-flow.test.mjs && node tests/workflow-v2.test.mjs && node tests/feishu-api-contracts.test.mjs && node tests/store-migration.test.mjs && node tests/http.test.mjs",
    "diagnose": "pnpm build && node scripts/diagnose.mjs",
    "diagnose:import": "pnpm build && node scripts/test-feishu-import.mjs",
    "tasks:backfill": "pnpm build && node scripts/backfill-tasks.mjs",
    "demo": "pnpm build && node scripts/demo.mjs && node scripts/export-portfolio.mjs",
    "verify:live": "pnpm build && node scripts/live-smoke.mjs",
    "docs:images": "python scripts/verify-screenshots.py"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.49.0",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@larksuiteoapi/node-sdk": {
      "axios": "1.18.1"
    }
  },
  "description": "Role-specific contract revision guidance and task follow-up for Finance, Operations, Commercial, and Legal in Feishu."
}
