NODE_ENV=development
PORT=3000
# PUBLIC_BASE_URL=https://bot.example.com

# 飞书自建应用：开放平台 -> 凭证与基础信息
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me

# 飞书事件订阅：开放平台 -> 事件与回调 -> 事件配置
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=replace_me

# 第一次本地测试不知道 chat_id 时先填 *。
# 在群里发“@合同机器人 我是谁”拿到 chat_id 后，再改成 oc_... 并重启服务。
FEISHU_CONTRACT_CHAT_ID=*

# 机器人在飞书群里被 @ 时显示的名字。换机器人时改成新机器人的名字。
FEISHU_BOT_MENTION_NAME=合同审查机器人

# 四位负责人 user_id。也可以让负责人在群里用“我是xx负责人”命令注册。
OWNER_COMMERCIAL_NAME=商务负责人
OWNER_COMMERCIAL_USER_ID=
OWNER_OPERATIONS_NAME=运营负责人
OWNER_OPERATIONS_USER_ID=
OWNER_LEGAL_NAME=法务负责人
OWNER_LEGAL_USER_ID=
OWNER_FINANCE_NAME=财务负责人
OWNER_FINANCE_USER_ID=

# AI 模型配置。
# 火山方舟/豆包推荐填 ARK_*。代码会优先读取 ARK_API_KEY / ARK_BASE_URL / ARK_VISION_MODEL。
ARK_API_KEY=
REVIEW_TEST_CC_ENABLED=false
REVIEW_TEST_CC_USER_IDS=

ARK_BASE_URL=
ARK_MODEL=
ARK_VISION_MODEL=

# 通用 OpenAI-compatible 写法也支持。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# 旧变量名兼容区：如果你已经在 .env 里填了这些，可以继续用。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

API_TIMEOUT_MS=300000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_MAX_TURNS=8

DATA_DIR=./data

# 当前归档会尝试调整原在线文档为组织内可编辑。
FEISHU_DOCUMENT_ARCHIVE_ENABLED=true
FEISHU_CONTRACT_ROOT_FOLDER_TOKEN=
FEISHU_TASKS_ENABLED=true
OWNER_COMMERCIAL_NAMES=
OWNER_COMMERCIAL_USER_IDS=
OWNER_OPERATIONS_NAMES=
OWNER_OPERATIONS_USER_IDS=
OWNER_LEGAL_NAMES=
OWNER_LEGAL_USER_IDS=
OWNER_FINANCE_NAMES=
OWNER_FINANCE_USER_IDS=
LOG_LEVEL=info
