NODE_ENV=development
PORT=3000
# PUBLIC_BASE_URL=https://bot.example.com

# App credentials from the Feishu developer console.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me

# Callback verification and optional event encryption.
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=replace_me

# Use a fixed group ID for production; * permits all groups.
# Match the bot display name used in mentions.
FEISHU_CONTRACT_CHAT_ID=*

# Configure role owners here or through supported runtime registration commands.
FEISHU_BOT_MENTION_NAME=Contract Copilot

# Set one model provider configuration; ARK values take priority.
OWNER_COMMERCIAL_NAME=Commercial owner
OWNER_COMMERCIAL_USER_ID=
OWNER_OPERATIONS_NAME=Operations owner
OWNER_OPERATIONS_USER_ID=
OWNER_LEGAL_NAME=Legal owner
OWNER_LEGAL_USER_ID=
OWNER_FINANCE_NAME=Finance owner
OWNER_FINANCE_USER_ID=

# Legacy variable aliases use the Chat Completions protocol.
# Archive integration may make linked documents organization-editable.
ARK_API_KEY=
REVIEW_TEST_CC_ENABLED=false
REVIEW_TEST_CC_USER_IDS=

ARK_BASE_URL=
ARK_MODEL=
ARK_VISION_MODEL=

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

API_TIMEOUT_MS=300000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_MAX_TURNS=8

DATA_DIR=./data

FEISHU_DOCUMENT_ARCHIVE_ENABLED=true
FEISHU_CONTRACT_ROOT_FOLDER_TOKEN=
FEISHU_TASKS_ENABLED=true
OWNER_COMMERCIAL_NAMES=
OWNER_COMMERCIAL_USER_IDS=
OWNER_OPERATIONS_NAMES=
OWNER_OPERATIONS_USER_IDS=
OWNER_LEGAL_NAMES=
OWNER_LEGAL_USER_IDS=
OWNER_FINANCE_NAMES=
OWNER_FINANCE_USER_IDS=
LOG_LEVEL=info
