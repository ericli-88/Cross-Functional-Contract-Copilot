NODE_ENV=production
PORT=4302
HOST_PORT=4302
PUBLIC_BASE_URL=https://contracts.example.com

FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_with_real_secret
FEISHU_ENCRYPT_KEY=replace_with_event_encrypt_key
FEISHU_VERIFICATION_TOKEN=replace_with_event_verification_token
FEISHU_CONTRACT_CHAT_ID=*
FEISHU_BOT_MENTION_NAME=合同审查机器人

OWNER_COMMERCIAL_NAME=商务负责人
OWNER_COMMERCIAL_USER_ID=
# 多负责人时优先填写下面两项，顺序一一对应；用英文逗号分隔。
OWNER_COMMERCIAL_NAMES=
OWNER_COMMERCIAL_USER_IDS=
OWNER_OPERATIONS_NAME=运营负责人
OWNER_OPERATIONS_USER_ID=
OWNER_OPERATIONS_NAMES=
OWNER_OPERATIONS_USER_IDS=
OWNER_LEGAL_NAME=法务负责人
OWNER_LEGAL_USER_ID=
OWNER_LEGAL_NAMES=
OWNER_LEGAL_USER_IDS=
OWNER_FINANCE_NAME=财务负责人
OWNER_FINANCE_USER_ID=
OWNER_FINANCE_NAMES=
OWNER_FINANCE_USER_IDS=

# 每个群一个文件夹、每份合同一个子文件夹；空根 token 表示应用云空间根目录。
FEISHU_DOCUMENT_ARCHIVE_ENABLED=true
FEISHU_CONTRACT_ROOT_FOLDER_TOKEN=

# 每份合同、每个职能只创建一个任务，后续版本追加到同一任务。
FEISHU_TASKS_ENABLED=true

# 测试抄送开关。开启后，下面每个测试 user_id 每版最多收到四张职能卡。
REVIEW_TEST_CC_ENABLED=false
REVIEW_TEST_CC_USER_IDS=

ARK_API_KEY=replace_with_real_ark_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-0-pro-260215

API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_MAX_TURNS=8
DATA_DIR=/app/data
